{
  "name": "Farmacia Yza · Dashboard Design Tokens",
  "source": "login_diseno/static/style.css + login_diseno/static/dashboard.css",
  "colors": {
    "Brand/Menta": "#19C3A5",
    "Brand/Teal oscuro": "#0E8F87",
    "Brand/Profundo": "#0A4F59",
    "Brand/Tinta": "#0D2B2E",
    "Brand/Azul": "#1B6FD1",
    "Brand/Cielo": "#7BE0FF",
    "Brand/Amarillo": "#FFD45C",
    "Brand/Rosa": "#FF8FA3",
    "UI/Fondo": "#F4F8F7",
    "UI/Superficie": "#FFFFFF",
    "UI/Linea": "#E2EEEB",
    "UI/Texto secundario": "#6E8B8D",
    "Estado/Éxito": "#12946F",
    "Estado/Alerta": "#D07D19",
    "Estado/Peligro": "#C94F62"
  },
  "gradients": {
    "Sidebar": "linear-gradient(180deg, #0A4F59 0%, #0B6E74 55%, #0E8F87 100%)",
    "KPI barra": "linear-gradient(90deg, #19C3A5, #7BE0FF)",
    "Barras gráfica": "linear-gradient(180deg, #2FE0C0 0%, #0E8F87 100%)",
    "Botón principal": "linear-gradient(180deg, #25D6B6 0%, #0E9C92 100%)",
    "Hero operador": "linear-gradient(120deg, #0A4F59 0%, #0B7F86 55%, #12A89A 100%)",
    "Tarjeta cristal login": "linear-gradient(145deg, rgba(255,255,255,.30), rgba(255,255,255,.10))"
  },
  "typography": {
    "fontFamily": "Poppins",
    "weights": [400, 500, 600, 700],
    "styles": {
      "H1 página": { "size": 26, "weight": 700, "lineHeight": 1.2, "color": "#0D2B2E" },
      "H2 sección": { "size": 21, "weight": 700, "lineHeight": 1.25, "color": "#0D2B2E" },
      "H3 panel": { "size": 15, "weight": 700, "lineHeight": 1.3, "color": "#0D2B2E" },
      "KPI valor": { "size": 23, "weight": 700, "lineHeight": 1.1, "color": "#0D2B2E" },
      "Cuerpo": { "size": 12, "weight": 400, "lineHeight": 1.5, "color": "#0D2B2E" },
      "Secundario": { "size": 11, "weight": 400, "lineHeight": 1.5, "color": "#6E8B8D" },
      "Etiqueta": { "size": 10, "weight": 600, "lineHeight": 1.4, "color": "#6E8B8D", "letterSpacing": 0.3 },
      "Chip": { "size": 10, "weight": 600, "lineHeight": 1.2, "color": "#0E8F87" }
    }
  },
  "radii": {
    "KPI/Panel": 18,
    "Tarjeta pequeña": 14,
    "Botón": 12,
    "Chip": 999,
    "Ícono contenedor": 12
  },
  "spacing": [4, 8, 12, 16, 18, 20, 24, 28, 32],
  "effects": {
    "shadow-panel": "0 12px 30px rgba(13,43,46,0.06)",
    "shadow-kpi": "0 12px 30px rgba(13,43,46,0.06)",
    "shadow-hero": "0 18px 36px rgba(10,79,89,0.20)",
    "glass-blur": "blur(24px) saturate(170%)"
  },
  "layout": {
    "frame": { "width": 1440, "height": 1024 },
    "sidebar": { "width": 264, "padding": "26px 18px 18px" },
    "topbar": { "height": 72, "padding": "0 32px" },
    "content": { "padding": "28px 32px 52px", "maxWidth": 1520 },
    "grid": { "columns": 4, "gap": 18 },
    "columns2": { "ratio": "2fr 1fr", "gap": 20 },
    "icon": { "size": 20, "stroke": 1.8 }
  }
}
